<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Property for logs directory -->
    <property name="LOG_DIR" value="${catalina.base:-/usr/local/tomcat}/logs"/>
    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>

    <!-- Console Appender for immediate visibility -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- File Appender for ByteBite application logs -->
    <appender name="BYTEBITE_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/bytebite.log</file>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/bytebite.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <timeBasedFileNamingAndTriggeringPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
                <maxFileSize>10MB</maxFileSize>
            </timeBasedFileNamingAndTriggeringPolicy>
            <maxHistory>90</maxHistory>
        </rollingPolicy>
    </appender>

    <!-- Async Appender for performance -->
    <appender name="ASYNC_CONSOLE" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <appender-ref ref="CONSOLE"/>
    </appender>

    <appender name="ASYNC_BYTEBITE" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <appender-ref ref="BYTEBITE_FILE"/>
    </appender>

    <!-- ByteBite application logger - captures all logs at DEBUG level and above -->
    <logger name="com.bytebite" level="DEBUG" additivity="false">
        <appender-ref ref="ASYNC_CONSOLE"/>
        <appender-ref ref="ASYNC_BYTEBITE"/>
    </logger>

    <!-- Specific loggers for key components -->
    <logger name="com.bytebite.servlet.LoginServlet" level="DEBUG">
        <appender-ref ref="ASYNC_CONSOLE"/>
        <appender-ref ref="ASYNC_BYTEBITE"/>
    </logger>

    <logger name="com.bytebite.filter.LDAPAuthenticationFilter" level="DEBUG">
        <appender-ref ref="ASYNC_CONSOLE"/>
        <appender-ref ref="ASYNC_BYTEBITE"/>
    </logger>

    <!-- Root logger configuration -->
    <root level="INFO">
        <appender-ref ref="ASYNC_CONSOLE"/>
    </root>
</configuration>
