<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee 
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <!-- Application Display Name -->
    <display-name>ByteBite Log Analysis AI</display-name>
    <description>Legacy Java web app with AI-powered log analysis, LDAP authentication, PostgreSQL persistence</description>

    <!-- Context Parameters -->
    <context-param>
        <param-name>app.name</param-name>
        <param-value>ByteBite</param-value>
    </context-param>
    <context-param>
        <param-name>app.version</param-name>
        <param-value>1.0.0</param-value>
    </context-param>
    <context-param>
        <param-name>log.level</param-name>
        <param-value>${LOG_LEVEL:INFO}</param-value>
    </context-param>

