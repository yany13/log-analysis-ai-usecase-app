<?xml version="1.0" encoding="UTF-8"?>
<Context>
  <!-- PostgreSQL DataSource for ByteBite -->
  <Resource
    name="jdbc/bytebite"
    auth="Container"
    type="javax.sql.DataSource"
    driverClassName="org.postgresql.Driver"
    url="jdbc:postgresql://postgres:5432/bytebite_db"
    username="bytebite"
    password="bytebite_secure_pwd_123"
    maxTotal="20"
    maxIdle="10"
    maxWaitMillis="30000"
    validationQuery="SELECT 1"
    testOnBorrow="true"
    testOnReturn="false"
    testWhileIdle="true"
    timeBetweenEvictionRunsMillis="34000"
    numTestsPerEvictionRun="3"
    minEvictableIdleTimeMillis="55000" />
</Context>
